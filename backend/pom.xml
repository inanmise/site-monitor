<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.sitemonitor</groupId>
    <artifactId>site-monitor</artifactId>
    <!-- CI-friendly sürüm: tek kaynak kök VERSION dosyası. Docker build `-Drevision=$(cat VERSION)` verir;
         yerel `mvn` koşumları 0.0.0-local üretir (jar adı site-monitor-0.0.0-local.jar; Dockerfile ve
         start-local.ps1 glob kullanır). Eskiden sabit 7.2.0 idi ve manifest yedeği bayat sürüm loglayabiliyordu. -->
    <version>${revision}</version>
    <name>site-monitor</name>

    <properties>
        <revision>0.0.0-local</revision>
        <java.version>25</java.version>
        <!-- Spring Boot 4.1.0'ın yönettiği Lombok JDK 25 javac'ını desteklemiyordu
             (annotation processor çalışmıyor → "cannot find symbol" üretilen getter/setter'larda).
             1.18.42 JDK 11-25 destekler. -->
        <lombok.version>1.18.42</lombok.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- BouncyCastle for OCSP/CRL revocation checking -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.81</version>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.81</version>
        </dependency>
        <!-- CommonMark — haftalık rapor markdown'ını mail HTML'ine çevirir -->
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.24.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>0.24.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-task-list-items</artifactId>
            <version>0.24.0</version>
        </dependency>
        <!-- Apache PDFBox — aylık sertifika envanteri raporunun PDF ekini SUNUCUDA üretir.
             Apache-2.0 (kurumsal bağımlılık politikası için en temiz lisans); ekrandaki dışa
             aktarım jsPDF ile tarayıcıda kalır, zamanlanmış mailde tarayıcı yok. -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.5</version>
        </dependency>
        <!-- PostgreSQL for production (Kubernetes) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Spring Session JDBC — shared sessions across nodes (HA) -->
        <dependency>
            <groupId>org.springframework.session</groupId>
            <artifactId>spring-session-jdbc</artifactId>
        </dependency>
        <!-- Caffeine — in-process L1 cache for low-latency reads -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- BCrypt password hashing (no full Spring Security needed) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- DNS — TTL, SOA, response_ms, authoritative servers -->
        <dependency>
            <groupId>dnsjava</groupId>
            <artifactId>dnsjava</artifactId>
            <version>3.6.2</version>
        </dependency>
        <!-- jsoup — sayfa-bütünlüğü (PageCheckerService) HTML parse + kaynak envanteri -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.18.3</version>
        </dependency>
        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SB4 modülerleşmesi: @WebMvcTest/@AutoConfigureMockMvc artık ayrı modülde,
             spring-boot-starter-test ile gelmiyor → web MVC slice testleri için açıkça ekle. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- SB4: @DataJpaTest de ayrı modülde (NotificationLogRepositoryTest / SqlSamplesIntegrationTest). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JDK 23+ artık annotation processor'ları classpath'ten otomatik
                 keşfetmiyor; Lombok'u açıkça processor path'e koy (yoksa JDK 25'te
                 getter/setter üretilmez → "cannot find symbol"). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <!-- Test JVM'ine bellek tavanı (2026-08-20 bellek denetimi).
                 NEDEN: Bu pom'da surefire yapılandırması HİÇ yoktu; fork edilen test JVM'i
                 varsayılan ergonomiyle (makine RAM'inin ~1/4'ü ≈ 4 GB MaxHeap) açılıyor ve JaCoCo
                 ajanı da bu kapaksız fork'un içinde koşuyordu. Depoda duran 15 hs_err kaydının
                 13'ü tam olarak bu şekilde üretilmiş: hiçbiri Java-heap OOM'u değil, JIT
                 derleyicisinin native arena'sı (arena.cpp) veya G1'in başlangıçta 256 MB
                 rezerve edememesi (os_windows.cpp) — yani makinede fiziksel RAM tükenmişken
                 (çökme anında boş RAM 292 MB–2.7 GB) açılan fazladan JVM'ler.
                 @{argLine} ZORUNLU: jacoco prepare-agent ajan bayrağını o değişkene yazar;
                 silinirse kapsam raporu boşalır ve `verify` eşik kuralları sessizce çöker. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- SAAT DILIMI SABIT: CI runner UTC, gelistirici makinesi Europe/Istanbul.
                         Sabitlenmeden once yerelde YESIL, CI'da KIRMIZI (ya da tersi) testler
                         mumkundu ve bu 2026-09-07'de uc ayri zaman bombasi olarak patladi.
                         UTC secildi ki YEREL kosum CI'i birebir uretsin — hata once burada
                         gorunsun. Servisler zaten acik ZoneId.of("Europe/Istanbul") kullaniyor,
                         yani uygulama davranisi bu bayraktan ETKILENMEZ; etkilenen tek sey
                         testlerin ciplak now() cagrilaridir. -->
                    <argLine>@{argLine} -Xmx1g -Xss512k -XX:+HeapDumpOnOutOfMemoryError -Duser.timezone=UTC</argLine>
                </configuration>
            </plugin>
            <!-- Code coverage report. Run via `mvn test`; output in target/site/jacoco/index.html -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.14</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                    <!-- Kapsam eşiği (regresyon kilidi). `verify` fazına bağlı → `mvn test` yalnız rapor üretir,
                         `mvn verify` (ve CI) eşiği ZORLAR. Karar: "ölç→taban→kademeli" — eşikler mevcut ölçülen
                         seviyenin hemen ALTINA konur (yeni testler geldikçe YUKARI çekilir). Kritik sertifika/alarm
                         sınıflarının çoğu ağ/proxy/RDAP-HTTP dalları içerdiğinden birim-testle %90'a çıkamaz;
                         bu yüzden hedef değil GERÇEK taban bağlanır (bugünkü değerler yorumda). -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals><goal>check</goal></goals>
                        <configuration>
                            <haltOnFailure>true</haltOnFailure>
                            <rules>
                                <!-- Genel taban (2026-08-06 ölçümü: satır %67.2, komut %64.6). -->
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.71</minimum></limit>
                                        <limit><counter>INSTRUCTION</counter><value>COVEREDRATIO</value><minimum>0.69</minimum></limit>
                                    </limits>
                                </rule>
                                <!-- Kritik sertifika/alarm sınıfları — her biri kendi tabanında (kademeli yukarı çekilir). -->
                                <!-- C3: ASAGIDAKI SINIFLARIN HIC KURALI YOKTU ve kapsamlari
                                     dusuk (LdapDirectoryService %14.6, DatabaseInfoService %2.0).
                                     Yalniz BUNDLE kuralina tabiydiler; orada 8 puan bosluk oldugu
                                     icin sessizce daha da gerileyebilirlerdi. Esikler olculenin
                                     2 puan altina konuldu: amac kapsami YUKSELTMEK degil,
                                     GERILEMEYI durdurmak. Test yazildikca yukari cekilir.
                                     DatabaseInfoService (%2.0) bilerek DISARIDA: bu kadar dusuk
                                     bir tabani cimentolamak yanlis guven verir; once testi yazilmali. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.LdapDirectoryService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.12</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.controller.UserPushController</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.22</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.controller.SystemController</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.45</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.SqlPlaygroundService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.42</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.ExtendedHealthService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.80</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.ChainValidationService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.45</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.TrWebWhoisClient</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.31</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.WhoisDomainClient</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.3</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.SmtpMailService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.31</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.NetworkDiagnosticsService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.16</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.SsrfGuard</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.98</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.MonitoringOutageService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.EscalationService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.66</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.DomainCheckerService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.8</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.RdapDomainExpiryService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.45</minimum></limit></limits>
                                </rule>
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.CertificateCheckerService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.47</minimum></limit></limits>
                                </rule>
                                <!-- Sentetik motorun kendisi: kullanıcı kodunu alt süreçte koşturan tek sınıf
                                     (sandbox, vekil/CA, maskeleme, sonuç sınıflama). Bundle kuralı bunun
                                     kapsamı düşse fark etmiyordu. Eşik BUGÜNKÜ orana göre (≈0.61) mandallandı. -->
                                <rule>
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.ScriptedCheckerService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.6</minimum></limit></limits>
                                </rule>
                                <!-- 2026-08 denetimiyle testi yazılan sınıflar. Bunlar BUNDLE kuralının içinde
                                     eriyordu: her biri tek başına %0'a düşse bile genel oran görünür şekilde
                                     kıpırdamazdı. Eşikler bugün ÖLÇÜLEN oranın hemen altına mandallandı
                                     (ölç→taban→kademeli); ölçüm parantez içinde. -->
                                <rule>   <!-- ölçülen 1.000 — CORS fail-safe + SPA cache politikası -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.config.WebConfig</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.98</minimum></limit></limits>
                                </rule>
                                <rule>   <!-- ölçülen 0.912 — 8 izleme ucunun ORTAK geçmiş motoru -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.CheckHistoryService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.89</minimum></limit></limits>
                                </rule>
                                <rule>   <!-- ölçülen 0.868 — bakım penceresi IDOR kapıları -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.controller.MaintenanceController</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.82</minimum></limit></limits>
                                </rule>
                                <rule>   <!-- ölçülen 1.000 — Teams/Slack gövde üreticileri + seviye→renk -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.WebhookService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.94</minimum></limit></limits>
                                </rule>
                                <rule>   <!-- ölçülen 0.751 — dashboard cache'lerinin sahibi -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.CertificateService</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.74</minimum></limit></limits>
                                </rule>
                                <rule>   <!-- ölçülen 0.594 — açılışta 9 tabloda toplu UPDATE, takım atar -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.MonitoringGroupBackfill</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.57</minimum></limit></limits>
                                </rule>
                                <rule>   <!-- ölçülen 0.525 — geri alınamaz saklama/purge uçları -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.controller.RetentionAdminController</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.5</minimum></limit></limits>
                                </rule>
                                <rule>   <!-- ölçülen 1.000 — trigger null dönerse aylık rapor sessizce ölür -->
                                    <element>CLASS</element>
                                    <includes><include>com.sitemonitor.service.report.CertInventoryReportScheduling</include></includes>
                                    <limits><limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit></limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Güvenlik: OWASP Dependency-Check (SCA). Varsayılan build'e girmez (NVD indirmesi ağır);
             on-demand `mvn -Psecurity verify` veya haftalık dependency-check.yml workflow'u çalıştırır.
             NVD hız limiti için NVD_API_KEY env/property verilebilir. -->
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>12.1.0</version>
                        <configuration>
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                            <formats>
                                <format>HTML</format>
                                <format>SARIF</format>
                            </formats>
                            <!-- Sadece derleme/runtime bağımlılıkları; test scope'u dışla. -->
                            <skipTestScope>true</skipTestScope>
                        </configuration>
                        <executions>
                            <execution>
                                <goals><goal>check</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
