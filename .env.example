# ─────────────────────────────────────────────────────────────
# CertMonitor — Local / Docker environment template
# Copy this file to .env and fill in your values.
# .env is NEVER committed to version control.
# ─────────────────────────────────────────────────────────────

# ── Application credentials ──────────────────────────────────
CERT_MONITOR_USERNAME=admin
CERT_MONITOR_PASSWORD=change-me-strong-password

# ── CORS (comma-separated allowed origins) ───────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email / SMTP ─────────────────────────────────────────────
CERT_MONITOR_EMAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
CERT_MONITOR_EMAIL_FROM=noreply@certmonitor

# ── PostgreSQL (when using prod profile) ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=certmonitor
DB_USER=certmonitor
DB_PASSWORD=change-me-db-password
