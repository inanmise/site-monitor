# ─────────────────────────────────────────────────────────────
# Site Monitor — Local / Docker environment template
# Copy this file to .env and fill in your values.
# .env is NEVER committed to version control.
# ─────────────────────────────────────────────────────────────

# ── Application credentials ──────────────────────────────────
SITE_MONITOR_USERNAME=admin
SITE_MONITOR_PASSWORD=change-me-strong-password

# ── CORS (comma-separated allowed origins) ───────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Email / SMTP ─────────────────────────────────────────────
SITE_MONITOR_EMAIL_ENABLED=false
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SITE_MONITOR_EMAIL_FROM=noreply@sitemonitor

# ── Başarısız-login anomali uyarısı (opsiyonel — hepsi admin UI'dan canlı ayarlanabilir) ──
# Alıcı boşsa SYSTEM_ADMIN_EMAIL'e düşer. Eşikler/pencere/cooldown için diğer FAILED_LOGIN_* override'ları
# application.properties'te tanımlı; genelde varsayılanlar yeterli.
FAILED_LOGIN_ALERT_ENABLED=true
FAILED_LOGIN_ALERT_RECIPIENTS=

# ── Outbound HTTP proxy (kurumsal egress — SSL/RDAP/registrar sorguları) ──
# Boş bırakılırsa doğrudan çıkış. Kurumsal ağda dış RDAP/CRL/OCSP erişimi için zorunlu olabilir.
# NO_PROXY: virgüllü sonek listesi — iç hedefler tünele girmesin.
# 2026-08 dersi: bu değerler deployment'a taşınmazsa Alan Adı İzleme sessizce veri çekemez hale gelir.
HTTP_PROXY_HOST=
HTTP_PROXY_PORT=
HTTP_PROXY_USER=
HTTP_PROXY_PASS=
NO_PROXY=localhost,127.0.0.1

# ── Alan Adı (registrar) izleme kaynakları ───────────────────
# whois-enabled: port-43 socket WHOIS (kurumsal HTTP proxy'den GEÇEMEZ — proxy arkasında false bırakın).
# tr-web-whois: .tr için HTTPS web-whois (isimtescil/TRABİS) — proxy'den geçer, varsayılan açık.
DOMAIN_WHOIS_ENABLED=true
DOMAIN_TR_WEB_WHOIS_ENABLED=true

# ── PostgreSQL (when using prod profile) ─────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=certmonitor
DB_USER=certmonitor
DB_PASSWORD=change-me-db-password

# ── Sayfa Bütünlüğü izleme (9. tür — opsiyonel; hepsi admin UI'dan canlı ayarlanabilir) ──
# alert-enabled=false izlemeyi tümüyle duraklatır. Retention gün-bazlı (gece batch-purge; FK: önce issues).
PAGE_ALERT_ENABLED=true
PAGE_RESOURCE_CONCURRENCY=5
PAGE_RETENTION_DAYS=180
PAGE_ISSUES_RETENTION_DAYS=90

# ── Senaryo İzleme (10. tür — k6; opsiyonel, admin UI'dan canlı) ──
# k6 binary'si Docker imajına K6_VERSION build-arg'ıyla eklenir. Yerel geliştirmede k6 yoksa tür "devre dışı" görünür.
# pool-size: eşzamanlı k6 süreç tavanı (diğer sweep'leri bloklamaz). max-timeout mutlak tavan 180 sn.
K6_VERSION=0.49.0
SCRIPTED_ENABLED=true
SCRIPTED_POOL_SIZE=2
SCRIPTED_DEFAULT_TIMEOUT_SECONDS=60
SCRIPTED_MAX_TIMEOUT_SECONDS=180
# WARN | BLOCK — kaydederken script gövdesinde sabit-kodlu secret literal'i tespitinde davranış.
SCRIPTED_HARDCODED_SECRET_POLICY=WARN
SCRIPTED_RETENTION_DAYS=180

# ─────────────────────────────────────────────────────────────
# Bellek / eşzamanlılık ayarları (2026-08-20 bellek denetimi)
# Hepsi OPSİYONELDİR; yazılmazsa application.properties varsayılanları geçerlidir.
# Buraya eklenmelerinin sebebi: bu değişkenler koda gömülü olmalarına rağmen hiçbir şablonda
# görünmüyordu, yani operatör varlıklarını bilmeden çalıştırıyordu.
# ─────────────────────────────────────────────────────────────

# JVM bayrakları. start-local.ps1 bunu okur ve -jar'dan ÖNCE geçirir (2026-08-20'de eklendi;
# öncesinde JAVA_OPTS sessizce yok sayılıyordu). Docker'da ENTRYPOINT, K8s'te ConfigMap kullanır.
# Aşağıdaki iki profil Faz 6 ölçümünden sonra kesinleşecek; şimdilik yorumlu bırakıldı.
#JAVA_OPTS=-Xms192m -Xmx512m -Xss512k -XX:+UseG1GC -XX:G1PeriodicGCInterval=300000 -XX:G1PeriodicGCSystemLoadThreshold=0 -XX:+HeapDumpOnOutOfMemoryError -XX:+ExitOnOutOfMemoryError

# Tomcat çalışan thread tavanı (varsayılan 100). Her thread -Xss kadar yığın rezerve eder.
#TOMCAT_MAX_THREADS=100

# HikariCP havuzu (varsayılan 25 / 10). Her bağlantı ~1-3 MB (prepared-statement cache) tutar.
# NOT: helm master.yaml prod'da DB_POOL_MAX=30 kullanıyor — POD BAŞINA'dır.
#DB_POOL_MAX=25
#DB_POOL_MIN=10

# Zamanlanmış görev havuzu (varsayılan 8).
#SCHEDULING_POOL_SIZE=8

# Sertifika/kontrol executor'ı (varsayılan 20 / 50 / kuyruk 5000). Kuyruktaki her görev
# yakaladığı DTO'ları canlı tutar; kuyruk derinliği doğrudan bellek demektir. Havuz+kuyruk
# dolunca görev çağıran thread'de koşar (CallerRuns) — Sistem Sağlığı kartı sayacı gösterir.
# Bunlar yalnız AÇILIŞ değeridir: üçü de Ayarlar → Genel → Görev Havuzu'ndan CANLI değiştirilir
# (yeniden başlatma/Helm upgrade gerekmez); DB'de saklı override env'in üstüne uygulanır.
#EXECUTOR_CORE_SIZE=20
#EXECUTOR_MAX_SIZE=50
#EXECUTOR_QUEUE_CAPACITY=5000

# ── Secret şifreleme anahtarı (SMTP/LDAP parolaları + Senaryo İzleme env secret'ları at-rest AES-256-GCM) ──
# PROD'da ZORUNLU (ayarlanmazsa prod profili açılışta durur). Pod'lar arası STABİL olmalı (K8s secret).
SITE_MONITOR_SECRET_KEY=change-me-to-a-long-random-stable-secret
